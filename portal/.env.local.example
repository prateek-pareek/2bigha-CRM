# Origin of the API — no /api suffix.
# src/common/lib/api/config.ts derives CRM_API_URL as `${NEXT_PUBLIC_API_URL}/api`.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Standalone CRM build: `/` dispatches to /crm/workspace rather than the
# suite's multi-product default route.
NEXT_PUBLIC_CRM_STANDALONE=true

# Set ONLY when the CRM API is on a different host than NEXT_PUBLIC_API_URL.
# Must include the /api suffix.
# NEXT_PUBLIC_CRM_API_URL=
