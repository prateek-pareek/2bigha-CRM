# CRM portal → CRM API (4001). HRMS uses API 4000 / UI 3000.
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_CRM_STANDALONE=true
PORT=3001

# Set ONLY when the CRM API is on a different host than NEXT_PUBLIC_API_URL.
# Must include the /api suffix.
# NEXT_PUBLIC_CRM_API_URL=http://localhost:4001/api
