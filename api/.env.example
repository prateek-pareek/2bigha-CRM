# ─── Mathionix CRM API ───────────────────────────────────────────────────────

# Primary MongoDB (users, auth, notifications, teams-bot, trash)
MONGO_URI=mongodb://127.0.0.1:27017/mathionix-crm

# CRM collections (leads, deals, inbox, workflows…)
MONGO_URI_CRM=mongodb://127.0.0.1:27017/mathionix-crm

# Optional: separate DB when reading PM issue progress for client portals.
# Leave unset to use MONGO_URI_CRM.
# MONGO_URI_PM=mongodb://127.0.0.1:27017/mathionix-pm

JWT_SECRET=change-me-in-production
PORT=4000

# Portal origin (CORS + OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Public API origin — no /api suffix (email tracking pixels, click redirects, inbox OAuth)
TRACKING_BASE_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
CRM_OAUTH_PUBLIC_URL=http://localhost:4000

# ─── Redis (optional — improves list/report caching) ─────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ─── Email (SMTP for campaigns / notifications) ─────────────────────────────
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@yourdomain.com

# ─── CRM inbox OAuth (Gmail / Microsoft) ─────────────────────────────────────
# CRM_INBOX_GOOGLE_CLIENT_ID=
# CRM_INBOX_GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── AI (outreach drafts, copilot, proposals) ────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=

# ─── Email intelligence providers (finder / verification) ────────────────────
# TOMBA_KEY=
# TOMBA_SECRET=
# HUNTER_API_KEY=

# ─── File & image uploads (stored on this server's local disk, ./uploads) ───
# IMAGE_UPLOAD_MAX_INPUT_BYTES=15728640
# FILE_UPLOAD_MAX_BYTES=26214400

# ─── Microsoft Teams integration ─────────────────────────────────────────────
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_SENDER_ID=

# ─── WhatsApp Business API (Meta Cloud API — direct) ─────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# App Secret used to verify the X-Hub-Signature-256 header on inbound
# webhooks/whatsapp POSTs is NOT read from env — it's stored on the same
# Integration doc as the credentials above (Settings → Integrations →
# WhatsApp → App Secret), since it's per-account like they are.

# ─── AiSensy (WhatsApp BSP — https://aisensy.com) ────────────────────────────
# The account API key itself is stored in the `Integration` doc (type:
# 'whatsapp', provider: 'aisensy') via Settings → Integrations → WhatsApp, the
# same way the Meta credentials above are — not here. Only the base URLs and
# an optional inbound-webhook shared secret live in env. Project API
# credentials (projectId / Project API Password, needed for free-text sends)
# also live on the Integration doc, same UI page.
# AISENSY_API_BASE_URL=https://backend.aisensy.com
# AISENSY_PROJECT_API_BASE_URL=https://apis.aisensy.com
# AISENSY_WEBHOOK_SECRET=

# ─── Meta Lead Ads (Facebook & Instagram lead-gen webhooks) ──────────────────
# Verify token Meta's webhook subscription handshake checks against (App
# Dashboard → Webhooks → Page → Subscribe → Verify and Save). The Page ID,
# long-lived Page Access Token, and optional App Secret (for X-Hub-Signature-256
# verification) all live on the Integration doc instead — Settings →
# Integrations → Meta Lead Ads — same as the WhatsApp credentials above.
# META_LEAD_ADS_WEBHOOK_VERIFY_TOKEN=

# ─── Website inbound (public lead/chat widgets) ──────────────────────────────
# CRM_WEBSITE_PUBLIC_API_KEY=

# ─── PM progress read mode for client portals: local | http | http-fallback ───
CRM_PM_READ_MODE=local
