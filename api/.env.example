# ─── Mathionix CRM API ───────────────────────────────────────────────────────

# Primary MongoDB (users, auth, notifications, teams-bot, trash)
MONGO_URI=mongodb://127.0.0.1:27017/mathionix-crm

# CRM collections (leads, deals, inbox, workflows…)
MONGO_URI_CRM=mongodb://127.0.0.1:27017/mathionix-crm

# Optional: separate DB when reading PM issue progress for client portals.
# Leave unset to use MONGO_URI_CRM.
# MONGO_URI_PM=mongodb://127.0.0.1:27017/mathionix-pm

JWT_SECRET=change-me-in-production
PORT=4000

# Portal origin (CORS + OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Public API origin — no /api suffix (email tracking pixels, click redirects, inbox OAuth)
TRACKING_BASE_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
CRM_OAUTH_PUBLIC_URL=http://localhost:4000

# ─── Redis (optional — improves list/report caching) ─────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ─── Email (SMTP for campaigns / notifications) ─────────────────────────────
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@yourdomain.com

# ─── CRM inbox OAuth (Gmail / Microsoft) ─────────────────────────────────────
# CRM_INBOX_GOOGLE_CLIENT_ID=
# CRM_INBOX_GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── AI (outreach drafts, copilot, proposals) ────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=

# ─── Email intelligence providers (finder / verification) ────────────────────
# TOMBA_KEY=
# TOMBA_SECRET=
# HUNTER_API_KEY=

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Microsoft Teams integration ─────────────────────────────────────────────
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_SENDER_ID=

# ─── WhatsApp Business API ───────────────────────────────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# ─── Website inbound (public lead/chat widgets) ──────────────────────────────
# CRM_WEBSITE_PUBLIC_API_KEY=

# ─── PM progress read mode for client portals: local | http | http-fallback ───
CRM_PM_READ_MODE=local
