# ═══════════════════════════════════════════════════════════════════════
# Production compose config (Hostinger VPS).  cp .env.example .env
# Read by docker-compose.yml only. The API's own runtime config that is
# NOT listed here comes from api/.env.example — this file wins for
# anything both define, because compose `environment:` overrides.
# ═══════════════════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────────────────────
# Public hostname. Its DNS A record must already point at this VPS's IPv4
# before you start Traefik, or the Let's Encrypt HTTP-01 challenge fails.
APP_DOMAIN=crm.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Signs every JWT. Generate with:  openssl rand -base64 48
# Changing it invalidates all existing sessions.
JWT_SECRET=

# Public origin of the API — no /api suffix. Must be https://$APP_DOMAIN,
# since Traefik routes /api on the same host to the backend.
# Baked into the frontend image at BUILD time: change it => rebuild.
NEXT_PUBLIC_API_URL=https://crm.example.com
PUBLIC_API_URL=https://crm.example.com
TRACKING_BASE_URL=https://crm.example.com
CRM_OAUTH_PUBLIC_URL=https://crm.example.com
FRONTEND_URL=https://crm.example.com

# Only if the CRM API is on a DIFFERENT host than NEXT_PUBLIC_API_URL.
# Leave blank otherwise — blank falls back to ${NEXT_PUBLIC_API_URL}/api.
# If you do set it, it MUST end in /api.
NEXT_PUBLIC_CRM_API_URL=

# ─── Database ──────────────────────────────────────────────────────────
# Leave BLANK to use the MongoDB container bundled in docker-compose.yml
# (data lives in the myapp_mongodb_data volume).
#
# To use an external/managed MongoDB instead, put its connection string here
# AND start the stack with the external-db override:
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
#
# Managed provider (Hostinger managed DB, Atlas, ...): paste their URI as-is.
# mongod running on this VPS host: use host.docker.internal, e.g.
#   mongodb://crm:PASSWORD@host.docker.internal:27017/mathionix-crm?authSource=admin
MONGO_URI=

# ─── Optional ──────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# SMTP — required for campaigns, invites and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Shared secret for internal client-portal calls. openssl rand -hex 32
INTERNAL_CLIENT_PORTAL_KEY=

# AI features (email drafting, copilot). Blank = those features stay off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=

# OAuth — only needed for "Continue with Google/Microsoft" and inbox sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRM_INBOX_GOOGLE_CLIENT_ID=
CRM_INBOX_GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=

# Microsoft Teams notifications.
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
TEAMS_SENDER_ID=
TEAMS_WEBHOOK_URL=
BOT_SERVICE_URL=

# Misc integrations.
SITE_CMS_PUBLIC_API_KEY=
PM_GITHUB_CLIENT_ID=
PM_GITHUB_CLIENT_SECRET=
SEMRUSH_API_KEY=
SERPAPI_API_KEY=

# Telephony / IVR (Kommuno)
KOMMUNO_API_KEY=
KOMMUNO_SME_ID=
KOMMUNO_VIRTUAL_NUMBER=
KOMMUNO_API_BASE_URL=https://dialer-crmapi.kommuno.com/v1/kcrm
KOMMUNO_WEBHOOK_SECRET=

# WhatsApp (AiSensy)
AISENSY_WEBHOOK_SECRET=
AISENSY_API_BASE_URL=https://backend.aisensy.com
